        if (hdr.ipv4.protocol == IPv4Proto.TCP && hdr.tcp.syn == 1) {
            WriteSYNFlagCount();
        } else if (new_flow) {
            // New flow without the flag: stores the count 0.
            flows_syn_flag_count.write(hashes.reg_idx32, syn_flag_count);
